+  const expansions = stale.pathStats.expansions;
+  stale.flags = new Uint16Array(3);
+  assert.deepEqual(publicRoute(stale, 0, 2), [], 'replacing public flags without advancing the region version retains the cached rejection');
+  assert.equal(stale.pathStats.regionRejected, 1, 'the stale public region rejects before a fine search');
+  assert.equal(stale.pathStats.expansions, expansions);
+  stale.infantryRegionVersion++;
