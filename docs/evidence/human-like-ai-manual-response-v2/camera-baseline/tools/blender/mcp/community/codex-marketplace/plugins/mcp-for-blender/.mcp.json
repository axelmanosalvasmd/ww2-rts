{
  "mcpServers": {
    "mcp-for-blender": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "exec /bin/bash \"$(git rev-parse --show-toplevel)/tools/blender/mcp/community/server.sh\""
      ],
      "env_vars": [
        "PATH",
        "HOME",
        "BLENDER_MCP_SAFE_MODE",
        "DISABLE_TELEMETRY",
        "BLENDER_MCP_DISABLE_TELEMETRY"
      ],
      "tool_timeout_sec": 600,
      "env": {
        "BLENDER_MCP_APPS": "1",
        "BLENDER_MCP_OPENAI_FORMS": "1"
      }
    }
  }
}
